# Lab09 default configuration — Ubuntu 22.04 + ROS 2 Humble mock backend
LAB09_MODE=mock
ROS_SETUP_FILE=/opt/ros/humble/setup.bash
WORKSPACE_SETUP_REL=ros2_ws/install/setup.bash

SCAN_TOPIC=/scan
LIDAR_NODE_EXACT=/lab09_mock_lidar
LIDAR_NODE_PATTERN=lab09_mock_lidar

SCAN_FRAME=laser
PUBLISH_RATE_HZ=10.0
SCAN_SAMPLE_COUNT=181
RANGE_MIN_M=0.12
RANGE_MAX_M=8.0
DATA_OBSERVE_SEC=4

# 0: RViz is checked manually by the learner. 1: also check for an RViz node name.
CHECK_RVIZ=0
RVIZ_NODE_PATTERN=rviz2

# Relative path is resolved from Lab09 root unless an absolute path is supplied.
EVIDENCE_DIR=evidence
