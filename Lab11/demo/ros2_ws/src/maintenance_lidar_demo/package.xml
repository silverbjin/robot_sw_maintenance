<?xml version="1.0"?>
<package format="3">
  <name>maintenance_lidar_demo</name>
  <version>1.0.0</version>
  <description>Deterministic ROS 2 LaserScan maintenance demo for Lab11.</description>
  <maintainer email="instructor@example.invalid">Lab Instructor</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-setuptools</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
